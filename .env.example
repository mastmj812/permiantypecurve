# Copy to .env and fill in. .env is gitignored.

# --- Database ---
POSTGRES_USER=permian
POSTGRES_PASSWORD=permian
POSTGRES_DB=permian
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://permian:permian@postgres:5432/permian

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me-in-prod
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Enverus (step 2) ---
ENVERUS_API_KEY_PRISM=
ENVERUS_API_KEY_DI=

# --- Basemap ---
# Absolute path inside the backend container. The compose file mounts
# ./infra/basemap to /app/basemap, so this stays stable.
PMTILES_PATH=/app/basemap/permian.pmtiles
PLSS_GEOJSON_PATH=/app/basemap/plss_tx_nm.geojson

# --- Frontend (Vite reads VITE_* only) ---
VITE_API_BASE_URL=/api
