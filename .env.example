# Copy to .env and fill in. .env is gitignored.

# --- Database ---
POSTGRES_USER=permian
POSTGRES_PASSWORD=permian
POSTGRES_DB=permian
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://permian:permian@postgres:5432/permian

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me-in-prod
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Warehouse (engineering_db) ---
# Read-only DSN for the engineering_db warehouse (curated.* materialized
# views). Powers the warehouse_client data layer that replaces the direct
# Enverus ingest.
#
# - From the backend docker container: use `host.docker.internal` so the
#   container can reach engineering_db's Postgres running on the host.
# - From local dev (uvicorn outside docker): use `localhost`.
# - The legacy compose Postgres also binds host 5432. Either run
#   engineering_db's Postgres on a different port (e.g. 5433) or stop
#   the compose stack when refreshing the warehouse.
#
# Leave blank to keep the legacy Enverus path active; warehouse_client
# calls will raise a clear error when invoked.
WAREHOUSE_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/oilgas

# --- Basemap ---
# Absolute path inside the backend container. The compose file mounts
# ./infra/basemap to /app/basemap, so this stays stable.
PMTILES_PATH=/app/basemap/permian.pmtiles
PLSS_GEOJSON_PATH=/app/basemap/plss_tx_nm.geojson

# --- Frontend (Vite reads VITE_* only) ---
VITE_API_BASE_URL=/api
